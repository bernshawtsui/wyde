{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default permissions for wyde",
  "windows": ["main", "wyde-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-title",
    "core:event:default",
    "dialog:allow-open",
    "opener:default",
    "opener:allow-open-url",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-watch",
    {
      "identifier": "fs:scope",
      "allow": ["**"]
    }
  ]
}
